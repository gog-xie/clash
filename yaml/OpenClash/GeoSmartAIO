# 配置说明：本配置文件是针对机场节点经常性不稳定制定的，比如晚高峰失联情况，高端长期都稳定的机场无需用此配置，配置有点套娃。
#          规则逻辑主要是策略故转→地区策略→故转、smart智选或手动指定某一节点，策略故转不是只有一个地区的节点的故障转移，而是优先第一个地区节点，当第一个地区失联时，会自动往后跳选可用的地区节点。
#          例如选择了策略故转HK，优选香港策略的节点，当香港策略全部节点不可用时，会自动选择第二个策略的节点，当第二个策略全部不可用时，会自动跳转至第三个策略节点，以此类推。
#          而在地区策略组中，还镶嵌了smart智选组和手动选择，不怕掉线，也能选择喜欢的节点，相对灵活，可长期免维护。
#          有种情况，当第一策略中不可用时，自动跳选第二策略组，用一段时间后，第一策略组恢复了，会遇到很久都不会自动跳回第一策略组，如果介意，可将“1.2 策略组类型模板”的BaseFB中hidden: true参数删除掉，这样在面板中故障转移策略组就会显示，可手动选择策略组，但也只能选择ping正常的策略组，如果选了不可用策略组，会自动跳转至下一可用故转策略组。

# 使用前在“1.5代理提供者”板块中添加你的订阅链接

# 1 锚点配置 
# 1.1 代理提供者模板 - 订阅源基础配置
BaseProvider: &BaseProvider {type: http, interval: 86400, proxy: DIRECT, health-check: {enable: true, url: 'https://www.google.com/generate_204', interval: 300}, filter: '^(?!.*(客户端|特殊|如果|导致|一下|教程|测试))'}

# 1.2 策略组类型模板 - 定义不同的策略组基础配置
BaseFB: &BaseFB {type: fallback, interval: 200, lazy: true, url: 'https://www.google.com/generate_204', hidden: true}
BaseCH: &BaseCH {type: load-balance, interval: 200, lazy: true, url: 'https://www.google.com/generate_204', strategy: consistent-hashing, hidden: true}   #散列：根据指定关键字做哈希运算，将连接固定映射到对应节点，节点变动时仅少量连接重新分配。
BaseCR: &BaseCR {type: load-balance, interval: 200, lazy: true, url: 'https://www.google.com/generate_204', strategy: round-robin, hidden: true}          #轮询：按顺序依次轮流分配连接到各个可用节点，循环往复。
#BaseGL: &BaseGL {type: load-balance, interval: 200, lazy: true, url: 'https://www.google.com/generate_204', strategy: sticky-sessions, hidden: true}     #目标：识别同一客户端会话，强制该会话全程使用首次分配到的节点，直到会话结束。（本配置未启用该模式，按需启用，并在“4.4 地理策略组”中添加各地区“均衡-目标”模式，以及启用各地区“4.8 负载均衡-目标”）
BaseUT: &BaseUT {type: url-test, interval: 200, lazy: true, url: 'https://www.google.com/generate_204', hidden: true}
BaseSmart: &BaseSmart {type: smart, interval: 200, lazy: true, url: 'https://www.google.com/generate_204', hidden: true, uselightgbm: true}

