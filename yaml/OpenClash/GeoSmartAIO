# 2 监听器 
listeners:
  # 2.1 Shadowsocks监听器 - 代理节点 玩法：远程连接家庭网络，端口和密码，使用时请修改
  - {name: SS-IN,  type: shadowsocks, listen: '::', port: 10000, udp: true, password: Xf3#Lp9WqZ, cipher: aes-256-gcm}
  # 2.2 Mixed监听器 - 分地区专用端口 玩法：本地浏览器插件或手机APP配置代理，实现分地区访问
  - {name: MIXED-SG, type: mixed, port: 50000, proxy: 狮城智选}
  - {name: MIXED-US, type: mixed, port: 50001, proxy: 美国智选}
  - {name: MIXED-TW, type: mixed, port: 50002, proxy: 台湾智选}
  - {name: MIXED-HK, type: mixed, port: 50003, proxy: 香港智选}
  - {name: MIXED-JP, type: mixed, port: 50004, proxy: 日本智选}
